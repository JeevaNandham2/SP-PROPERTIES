{
  "name": "sp-properties",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "SP Properties — website for apartments and villas in Ambattur, Chennai. Built by Digitalzi.",
  "scripts": {
    "dev": "next dev --turbopack --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "preview": "npm run build && npm run start -- --hostname 0.0.0.0 --port 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepare:content": "node scripts/prepare-content.mjs",
    "build:admin": "node scripts/build-admin.mjs",
    "predev": "npm run prepare:content && npm run build:admin",
    "prebuild": "npm run prepare:content && npm run build:admin",
    "pretypecheck": "node scripts/ensure-content.mjs",
    "pretest": "node scripts/ensure-content.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@netlify/blobs": "^11.1.9",
    "@netlify/functions": "^6.1.1",
    "@netlify/identity": "^2.0.1",
    "lenis": "1.3.27",
    "lucide-react": "^0.468.0",
    "next": "^15.5.29",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.92.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
