# Public site URL (used for canonical URLs, sitemap and schema)
NEXT_PUBLIC_SITE_URL=https://spproperties.co.in
# WhatsApp number that receives all enquiries (country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=919500124126
# Google Search Console verification token (optional)
NEXT_PUBLIC_GSC_VERIFICATION=
# Google Analytics 4 measurement ID (optional, e.g. G-XXXXXXX)
NEXT_PUBLIC_GA_ID=

# Private project editor: configure these in Netlify, never in NEXT_PUBLIC_*.
CMS_ENABLED=true
CMS_ADMIN_EMAIL=sppropertiessp@gmail.com
# Set through Netlify environment variables, scoped to Functions. Keep this secret.
CMS_BUILD_HOOK=
